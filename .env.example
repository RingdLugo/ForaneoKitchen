# Variables de entorno de ejemplo para ForáneoKitchen
# Copia este archivo a `.env` y rellena los valores reales.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP / Nodemailer (usa una contraseña de aplicación de Google si usas Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu_contraseña_de_aplicación_aquí
FROM_EMAIL=ForaneoKitchen <no-reply@tudominio.com>

# Puerto del servidor
PORT=3000

# (Opcional) Secreto para proteger el endpoint de prueba `/api/_test-send-otp`
# Pon aquí una cadena larga y mantenla fuera de repositorios públicos.
TEST_SEND_SECRET=valor_largo_y_secreto
